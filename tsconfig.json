{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js"],
  "exclude": ["src/legacy.js"]
}
